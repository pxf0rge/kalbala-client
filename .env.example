# Rahmani Marketplace — Environment Variables
# Copy this file to `.env` and fill in your Supabase credentials.
# NEVER commit real credentials to version control.

# --- Flutter client (safe with RLS) ---
APP_ENV=dev
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# DEV-only: no SMS — OTP screen shows a fixed code (default 123456).
# Requires the dev-login Edge Function deployed and DEV_LOGIN_KEY set as a
# function secret with the same value. NEVER set in production.
# DEV_LOGIN_KEY=
# DEV_OTP_CODE=123456

# --- Integration tests (dedicated test project only) ---
# SUPABASE_TEST_URL=https://your-test-project.supabase.co
# SUPABASE_TEST_ANON_KEY=your-test-anon-key

# --- Production smoke tests (read-only, optional) ---
# SUPABASE_PROD_URL=https://your-prod-project.supabase.co
# SUPABASE_PROD_ANON_KEY=your-prod-anon-key

# --- Server-side only (Supabase Edge Function secrets) ---
# Do NOT put these in Flutter or commit them to git.
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# PAYMENT_SANDBOX=true
# HESABPAY_API_KEY=
# AUTOMAPAY_API_KEY=
# SMS_API_KEY=
# FCM_SERVER_KEY=

# --- Optional: Twilio for Supabase Auth SMS ---
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
